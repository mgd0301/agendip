# --- Servidor ---
PORT=3001
# En producción: production (exige un JWT_SECRET fuerte y un CORS_ORIGIN concreto)
NODE_ENV=development

# --- Base de datos ---
# En Railway se pueden dejar vacías: se usan solas las variables MYSQLHOST, MYSQLPORT,
# MYSQLUSER, MYSQLPASSWORD y MYSQLDATABASE que crea la base MySQL del proyecto.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agendia

# --- Sesiones ---
# Clave aleatoria de al menos 32 caracteres. Para generar una:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar-esta-clave-por-una-larga-y-secreta
JWT_EXPIRES=12h

# --- Frontend ---
# Dominio(s) desde donde se usa la app, separados por coma. "*" solo en desarrollo.
CORS_ORIGIN=*
# Dirección pública del frontend: se usa en el link del email de recuperación de contraseña.
APP_URL=http://localhost:5173

# --- Zona horaria de los consultorios (no depende de la del servidor) ---
APP_TZ=America/Argentina/Buenos_Aires

# --- Emails (recuperación de contraseña) por Resend: https://resend.com ---
# Sin RESEND_API_KEY el email se muestra en la consola del backend.
RESEND_API_KEY=
# Remitente: con dominio propio verificado en Resend, ej. "Agendip <no-responder@agendip.com>"
MAIL_FROM=

# --- Proxy ---
# Cantidad de proxies delante del backend (Railway: 1). 0 si se expone directo.
TRUST_PROXY=1
